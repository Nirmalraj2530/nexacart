# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local MongoDB: mongodb://127.0.0.1:27017/nexacart
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexacart?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nexacart

# JWT Secrets & Expiration
JWT_SECRET=nexacart_jwt_super_secret_key_2026_production_grade
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000

